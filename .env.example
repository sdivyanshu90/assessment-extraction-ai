# Server-only: never prefix this with NEXT_PUBLIC_
OPENROUTER_API_KEY=

# Best-performing reproducible free model in the included benchmark (2026-08-26).
# Override this as free-model availability changes.
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=VedaAI Assessment Mapper

# Optional: enables structured request/response timing in server logs without
# logging question or student-answer content.
AI_BENCHMARK_LOGS=false
